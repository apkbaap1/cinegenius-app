[
 {"id":"01","v":"Bhavana","s":3.4,"e":7.8,"t":"పంచతంత్ర కథలు. కోతి, మొసలి."},
 {"id":"02","v":"Bhavana","s":8.3,"e":13.6,"t":"ఒక నది ఒడ్డున, పెద్ద నేరేడు చెట్టు మీద, ఒక కోతి ఉండేది."},
 {"id":"03","v":"Bhavana","s":13.9,"e":19.0,"t":"రోజూ ఆ నదిలోని మొసలికి, కోతి తియ్యటి నేరేడు పండ్లు విసిరేది."},
 {"id":"04","v":"Bhavana","s":19.4,"e":22.0,"t":"అలా ఇద్దరూ మంచి స్నేహితులయ్యారు."},
 {"id":"05","v":"Srinivas","s":24.4,"e":27.4,"t":"మిత్రమా, మా ఇంటికి రా. నా వీపు మీద ఎక్కు!"},
 {"id":"06","v":"Bhavana","s":27.6,"e":29.4,"t":"కోతి సంతోషంగా ఎక్కింది."},
 {"id":"07","v":"Bhavana","s":30.0,"e":39.5,"t":"మొసలి కోతిని వీపు మీద ఎక్కించుకుని, నది మధ్యకు ఈదుకుంటూ వెళ్ళింది."},
 {"id":"08","v":"Bhavana","s":40.6,"e":44.0,"t":"నది మధ్యలో, మొసలి నిజం చెప్పింది."},
 {"id":"09","v":"Srinivas","s":44.4,"e":48.3,"t":"నా భార్యకు నీ గుండె కావాలట. అందుకే నిన్ను తీసుకెళ్తున్నా."},
 {"id":"10","v":"Bhavana","s":48.6,"e":50.3,"t":"కోతి గుండె జారిపోయింది."},
 {"id":"11","v":"Bhavana","s":50.5,"e":52.8,"t":"కానీ వెంటనే ఆలోచించింది."},
 {"id":"12","v":"Pranay","s":53.3,"e":58.6,"t":"అయ్యో మిత్రమా! నా గుండె చెట్టు మీదే పెట్టి వచ్చాను. వెనక్కి తీసుకెళ్ళు, తెచ్చిస్తా!"},
 {"id":"13","v":"Bhavana","s":59.0,"e":63.0,"t":"మొసలి నమ్మి వెనక్కి ఈదింది. ఒడ్డు రాగానే,"},
 {"id":"14","v":"Bhavana","s":63.2,"e":65.6,"t":"కోతి ఒక్క దూకుతో చెట్టెక్కేసింది."},
 {"id":"15","v":"Pranay","s":66.0,"e":69.8,"t":"మూర్ఖుడా! గుండె లేకుండా ఎవరైనా బతుకుతారా?"},
 {"id":"16","v":"Bhavana","s":70.3,"e":73.5,"t":"మొసలి సిగ్గుతో వెళ్ళిపోయింది."},
 {"id":"17","v":"Bhavana","s":74.5,"e":77.5,"t":"ఆపదలో తెలివే రక్ష."}
]
